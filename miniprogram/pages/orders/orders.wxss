.orders-page {
  padding-top: 28rpx;
}

.orders-head {
  display: flex;
  align-items: center;
  padding: 4rpx 4rpx 18rpx;
}

.orders-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #8A7A6B;
}

.filter-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.filter-chip {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: #FFFDF8;
  border: 2rpx solid #EADCC9;
  font-size: 23rpx;
  color: #6F6155;
}

.filter-on {
  background: #2A211B;
  border-color: #2A211B;
  color: #FFFDF8;
  font-weight: 700;
}

.loading-card {
  min-height: 180rpx;
}

.retry {
  margin-top: 24rpx;
}

.order-list {
  padding-bottom: 10rpx;
}
