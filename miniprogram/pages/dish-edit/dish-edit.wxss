.edit-page {
  padding-top: 28rpx;
}

.loading-card {
  min-height: 200rpx;
}

.retry {
  margin-top: 24rpx;
}

.preview-card {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 26rpx;
  border-radius: 28rpx;
  background: #FDF1D8;
  border: 2rpx solid #EBD3A1;
}

.preview-emoji {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: #FFFDF8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  flex: none;
}

.preview-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #4A2E08;
}

.preview-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9A6A12;
}

.preview-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8A6A38;
  line-height: 1.5;
}

.off-tag {
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #E7E0D6;
  color: #8A7A6B;
  font-size: 19rpx;
  flex: none;
}

.form-card {
  margin-top: 20rpx;
}

.field {
  margin-bottom: 26rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #4A3B2F;
}

.field-count {
  margin-bottom: 10rpx;
  font-size: 20rpx;
  color: #A29384;
}

.field-textarea {
  min-height: 96rpx;
}

.field-hint {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #A29384;
  line-height: 1.5;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.cat-chip {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #F7F1E8;
  border: 2rpx solid #EADCC9;
  font-size: 24rpx;
  color: #6F6155;
}

.cat-on {
  background: #D94F2B;
  border-color: #D94F2B;
  color: #FFFDF8;
  font-weight: 700;
}

.emoji-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 10rpx;
}

.emoji-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border-radius: 16rpx;
  background: #FBF7EF;
  border: 2rpx solid transparent;
  font-size: 38rpx;
}

.emoji-on {
  background: #FFF4DA;
  border-color: #E7A83D;
}

.available-field {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-top: 6rpx;
}

.save-btn {
  margin-top: 28rpx;
}
