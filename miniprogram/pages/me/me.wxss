.me-page {
  padding-top: 28rpx;
}

.loading-card {
  min-height: 200rpx;
}

.retry {
  margin-top: 24rpx;
}

.profile-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 26rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #FDF1D8 0%, #FFF9EC 100%);
  border: 2rpx solid #EBD3A1;
  box-shadow: 0 10rpx 0 rgba(42, 33, 27, 0.05);
}

.profile-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 32rpx;
  background: #FFFDF8;
  border: 2rpx solid #EBD3A1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 58rpx;
  flex: none;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 800;
  color: #3F2A10;
}

.profile-role {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8A6A38;
}

.profile-joined {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #A98C5A;
}

.edit-btn {
  flex: none;
}

.me-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin-top: 18rpx;
}

.me-stat {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  padding: 18rpx 8rpx;
  border-radius: 20rpx;
  background: #FFFDF8;
  border: 2rpx solid #EADCC9;
  text-align: center;
}

.me-stat-value {
  font-size: 32rpx;
  font-weight: 900;
  color: #D94F2B;
  line-height: 1.2;
}

.me-stat-label {
  font-size: 18rpx;
  color: #8A7A6B;
}

.me-stat-foot {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #A29384;
  text-align: center;
}

.config-card {
  margin-top: 20rpx;
}

.slider-block {
  margin-top: 20rpx;
}

.slider-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #4A3B2F;
}

.slider-value {
  font-size: 24rpx;
  font-weight: 800;
  color: #D94F2B;
}

.config-hint {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: #8A7A6B;
}

.config-save {
  margin-top: 20rpx;
}

.config-read {
  margin-top: 14rpx;
  font-size: 29rpx;
  font-weight: 700;
  color: #D94F2B;
}

.link-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 16rpx;
  padding-top: 22rpx;
  padding-bottom: 22rpx;
}

.arrow {
  font-size: 42rpx;
  color: #C3B4A2;
  line-height: 1;
}

.mock-card {
  margin-top: 20rpx;
  background: #FBF7EF;
}

.mock-note {
  margin-top: 10rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #FFFDF8;
  font-size: 21rpx;
  line-height: 1.6;
  color: #7A6A58;
}

.mock-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed #EADCC9;
}

.mock-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #4A3B2F;
}

.mock-actions {
  margin-top: 18rpx;
}

.about-card {
  margin-top: 20rpx;
  background: #F7F1E8;
  text-align: center;
}

.about-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #5E4C3D;
}

.about-line {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #9A8877;
}

.me-foot {
  padding: 32rpx 0 16rpx;
  text-align: center;
  font-size: 21rpx;
  letter-spacing: 6rpx;
  color: #B6A795;
}

.profile-sheet {
  max-height: 88vh;
  overflow-y: auto;
}

.sheet-hint {
  margin: -6rpx 0 18rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #8A7A6B;
}

.profile-input {
  margin-bottom: 18rpx;
}

.avatar-grid {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.avatar-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  border-radius: 14rpx;
  background: #FBF7EF;
  border: 2rpx solid transparent;
  font-size: 34rpx;
}

.avatar-on {
  background: #FFF4DA;
  border-color: #E7A83D;
}

.sheet-cancel {
  margin-top: 14rpx;
}
