.setup-page {
  padding-top: 44rpx;
}

.hero {
  text-align: center;
  padding: 16rpx 10rpx 30rpx;
}

.hero-mark {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 42rpx;
  background: #FFFDF8;
  border: 2rpx solid #EADCC9;
  box-shadow: 0 10rpx 0 #EFE2D0;
  font-size: 72rpx;
}

.hero-sub {
  margin-top: 8rpx;
  color: #8A7A6B;
  font-size: 26rpx;
}

.hero-receipt {
  width: 84%;
  margin: 26rpx auto 0;
  padding: 22rpx 26rpx;
  background: #FFFDF8;
  border: 2rpx dashed #D8C5AC;
  border-radius: 18rpx;
  text-align: left;
  transform: rotate(-1.4deg);
}

.hero-line {
  display: block;
  font-size: 23rpx;
  color: #6F6155;
  line-height: 1.9;
}

.hero-line::before {
  content: "· ";
  color: #D94F2B;
  font-weight: 800;
}

.loading-card {
  min-height: 180rpx;
}

.retry {
  margin-top: 26rpx;
}

.closed-card {
  text-align: center;
  padding: 46rpx 34rpx;
}

.closed-stamp {
  margin-bottom: 22rpx;
  font-size: 34rpx;
  padding: 12rpx 28rpx;
}

.closed-text {
  margin-top: 12rpx;
  line-height: 1.7;
}

.role-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.role-card {
  position: relative;
  min-height: 300rpx;
  padding: 26rpx 22rpx;
  background: #FFFDF8;
  border: 2rpx solid #EADCC9;
  border-radius: 30rpx;
  box-shadow: 0 8rpx 0 rgba(42, 33, 27, 0.05);
  display: flex;
  flex-direction: column;
}

.role-card.active {
  border-color: #D94F2B;
  background: #FFF9F2;
  box-shadow: 0 8rpx 0 #F2C1B4;
}

.role-card.taken {
  opacity: 0.48;
}

.role-emoji {
  font-size: 56rpx;
  line-height: 1.2;
}

.role-name {
  margin-top: 14rpx;
  font-size: 29rpx;
  font-weight: 800;
  color: #2A211B;
}

.role-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8A7A6B;
}

.role-tag {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #F0ECE7;
  color: #8A7A6B;
  font-size: 19rpx;
}

.role-tag.ok {
  background: #FBE9E4;
  color: #B93B1B;
}

.form-card {
  margin-top: 24rpx;
}

.slider-block {
  margin-top: 26rpx;
  padding: 20rpx 20rpx 12rpx;
  border-radius: 22rpx;
  background: #FBF3E7;
}

.slider-label {
  font-size: 25rpx;
  font-weight: 600;
}

.slider-value {
  font-size: 25rpx;
  font-weight: 800;
  color: #D94F2B;
}

.slider-hint {
  display: block;
  margin-top: 2rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: #8A7A6B;
}

.submit {
  margin-top: 34rpx;
}
