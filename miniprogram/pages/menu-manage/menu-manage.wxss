.menu-page {
  padding-top: 28rpx;
}

.loading-card {
  min-height: 200rpx;
}

.retry {
  margin-top: 24rpx;
}

.menu-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 4rpx 4rpx 22rpx;
}

.menu-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #8A7A6B;
}

.dish-card {
  margin-bottom: 16rpx;
  padding-bottom: 0;
  overflow: hidden;
}

.dish-off {
  background: #F7F1E8;
}

.dish-main {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.dish-emoji {
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  background: #FBF4E8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex: none;
}

.dish-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.dish-name {
  font-size: 29rpx;
  font-weight: 700;
  color: #2A211B;
}

.off-tag {
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #E7E0D6;
  color: #8A7A6B;
  font-size: 18rpx;
}

.dish-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8A7A6B;
  line-height: 1.5;
}

.dish-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

.cat-tag {
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #FDF1D8;
  color: #9A6A12;
  font-size: 19rpx;
}

.dish-price {
  font-size: 25rpx;
  font-weight: 700;
  color: #D94F2B;
}

.dish-ops {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 14rpx 0;
  border-top: 2rpx dashed #EADCC9;
}

.op-toggle {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.op-label {
  font-size: 21rpx;
  color: #8A7A6B;
}

.op-btns {
  display: flex;
  gap: 12rpx;
}

.mini-btn {
  margin: 0;
  padding: 0 20rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 26rpx;
  background: #FFFDF8;
  border: 2rpx solid #EADCC9;
  font-size: 22rpx;
  color: #4A3B2F;
}

.mini-btn::after {
  border: none;
}

.mini-danger {
  background: #FBE9E4;
  border-color: #F2C1B4;
  color: #B93B1B;
}
