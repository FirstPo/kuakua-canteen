.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 950;
  display: flex;
  align-items: flex-end;
  background: rgba(42, 33, 27, 0.46);
}

.sheet {
  width: 100%;
  max-height: 88vh;
  padding: 34rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
  background: #FFFDF8;
  border-radius: 38rpx 38rpx 0 0;
  border-top: 2rpx solid #EADCC9;
  overflow-y: auto;
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.sheet-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #2A211B;
}

.sheet-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #8A7A6B;
}

.close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #F4E8D8;
  color: #8A7A6B;
  font-size: 36rpx;
  line-height: 1;
}

.rule {
  display: flex;
  gap: 18rpx;
  padding: 24rpx 0;
  border-bottom: 2rpx dashed #EADCC9;
}

.rule-no {
  flex-shrink: 0;
  width: 54rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #D94F2B;
  letter-spacing: 1rpx;
}

.rule-body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.rule-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2A211B;
}

.rule-text {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: #6F6155;
}

.chef-note {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #FDF1D8;
  color: #7B5714;
  font-size: 24rpx;
  line-height: 1.6;
}

.btn {
  margin-top: 28rpx;
  height: 86rpx;
  border-radius: 43rpx;
  background: #D94F2B;
  color: #FFFDF8;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn::after {
  border: none;
}
