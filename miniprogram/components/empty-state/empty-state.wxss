.empty-state {
  padding: 60rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.emoji {
  font-size: 68rpx;
  line-height: 1.2;
}

.title {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #2A211B;
}

.desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8A7A6B;
  line-height: 1.6;
}

.btn {
  margin-top: 26rpx;
  height: 68rpx;
  padding: 0 34rpx;
  border-radius: 34rpx;
  background: #D94F2B;
  color: #FFFDF8;
  font-size: 25rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn::after {
  border: none;
}
